# systemd unit for the PUBLIC read-only status page only.
# The control GUI (gui.py) is NOT run by this unit; it stays on 127.0.0.1 and is reached over SSH.
#
# Install on the VM:
#   sudo cp auto-dev-crew-public.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now auto-dev-crew-public
#
# Replace APP_USER and APP_DIR before installing. APP_DIR must contain the .venv created from requirements.txt.

[Unit]
Description=Auto Dev Crew public status (read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=APP_USER
WorkingDirectory=APP_DIR
ExecStart=APP_DIR/.venv/bin/python -m auto_dev_crew.public_view --host 127.0.0.1 --port 8080
Restart=on-failure
RestartSec=5

# Hardening: the public process only reads config.yaml and state/history.json.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=APP_DIR
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
