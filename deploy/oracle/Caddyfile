# Caddy terminates HTTPS (automatic Let's Encrypt) and forwards only to the public view.
# Replace status.example.com with your own domain (A record must point to the VM's public IP).
# Only ports 80 and 443 are opened to the internet. Port 8765 (control GUI) is never proxied here.

status.example.com {
	reverse_proxy 127.0.0.1:8080

	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Only GET/HEAD are meaningful for the public page; the app already returns 405 for other methods.
}
